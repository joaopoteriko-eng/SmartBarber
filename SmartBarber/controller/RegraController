<?php
class RegraController extends Controller
{
    public function index(): void
    {
        $u = $this->exigir(['dono']);
        $this->view('regra/index', ['regras' => RegraDesconto::listar($u['id_barbearia'])]);
    }

    public function salvar(): void
    {
        $u = $this->exigir(['dono']);
        $this->somentePost();

        $dia    = (int)($_POST['dia_semana'] ?? 0);
        $inicio = $_POST['hora_inicio'] ?? '';
        $fim    = $_POST['hora_fim'] ?? '';
        $pct    = numero_decimal($_POST['porcentagem'] ?? '0');

        $horaOk = preg_match('/^\d{2}:\d{2}$/', $inicio) && preg_match('/^\d{2}:\d{2}$/', $fim);
        if ($dia < 1 || $dia > 7 || !$horaOk || $fim <= $inicio || $pct <= 0 || $pct > 100) {
            flash('danger', 'Dados inválidos: o horário final deve ser maior que o inicial e o desconto deve ficar entre 1 e 100%.');
            $this->redirecionar('regra/index');
        }

        RegraDesconto::criar($u['id_barbearia'], $dia, $inicio . ':00', $fim . ':00', $pct);
        flash('success', 'Regra de desconto criada.');
        $this->redirecionar('regra/index');
    }

    public function excluir(): void
    {
        $u = $this->exigir(['dono']);
        $this->somentePost();
        RegraDesconto::excluir((int)($_POST['id_regra'] ?? 0), $u['id_barbearia']);
        flash('success', 'Regra excluída.');
        $this->redirecionar('regra/index');
    }
}